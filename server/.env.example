# Backend Server Environment Variables Template
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production
MONGODB_URI=mongodb://localhost:27017/thabat

# Administrator bootstrap (stored hashed in the database on first run).
# Use a strong, unique password. You can change it later from the admin console
# or with the email OTP password-reset flow.
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_NAME=Programme Administrator
ADMIN_PHONE=

# Optional development-only OTP bypass (NEVER enable in production).
# ALLOW_DEV_OTP_BYPASS=true

# Brevo (Sendinblue) SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-your-brevo-smtp-key-here
EMAIL_FROM=THABĀT | ثبات <your_brevo_account_email@gmail.com>

# Alternative: Resend Configuration
RESEND_API_KEY=
